% Raise apogee to 8000 km using a differential corrector; target tolerance 0.01 km.
Create Spacecraft Sat;
GMAT Sat.DateFormat = UTCGregorian;
GMAT Sat.Epoch = '01 Jan 2026 00:00:00.000';
GMAT Sat.CoordinateSystem = EarthMJ2000Eq;
GMAT Sat.DisplayStateType = Cartesian;
GMAT Sat.X = 7000;
GMAT Sat.Y = 0;
GMAT Sat.Z = 0;
GMAT Sat.VX = 0;
GMAT Sat.VY = 7.546053290107542;
GMAT Sat.VZ = 0;
Create ForceModel FM;
GMAT FM.CentralBody = Earth;
GMAT FM.PrimaryBodies = {};
GMAT FM.PointMasses = {Earth};
GMAT FM.Drag = None;
GMAT FM.SRP = Off;
Create Propagator Prop;
GMAT Prop.FM = FM;
GMAT Prop.Accuracy = 1e-12;
Create ImpulsiveBurn Burn;
GMAT Burn.CoordinateSystem = Local;
GMAT Burn.Origin = Earth;
GMAT Burn.Axes = VNB;
GMAT Burn.Element1 = 0.2;
Create DifferentialCorrector DC;
GMAT DC.MaximumIterations = 30;
Create ReportFile Results;
GMAT Results.Filename = 'targeting.txt';
GMAT Results.Precision = 16;
BeginMissionSequence;
Target DC {SolveMode = Solve, ExitMode = SaveAndContinue};
   Vary DC(Burn.Element1 = 0.2, {Perturbation = 0.0001, Lower = 0, Upper = 1, MaxStep = 0.2});
   Maneuver Burn(Sat);
   Propagate Prop(Sat) {Sat.Apoapsis};
   Achieve DC(Sat.RMAG = 8000, {Tolerance = 0.01});
EndTarget;
Report Results Sat.A1ModJulian Sat.X Sat.Y Sat.Z Sat.VX Sat.VY Sat.VZ;
